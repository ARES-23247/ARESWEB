rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    match /events/{eventId}/photos/{photoId} {
      // The read/write boundary is the publication-aware calendar API.
      allow read, write: if false;
    }

    match /blog/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    match /gallery/{allPaths=**} {
      allow read: if true;
      // Gallery media is validated, normalized, and written by the Admin SDK route.
      allow write: if false;
    }

    match /cad/{allPaths=**} {
      allow read, write: if false;
    }

    match /editor/uploads/{allPaths=**} {
      // Sponsor and editor media must pass through same-origin API routes.
      allow read, write: if false;
    }

    match /public-media/{allPaths=**} {
      // New media is private at the Storage boundary. Public pages receive it
      // only through publication-aware, same-origin API gateways.
      allow read, write: if false;
    }

    match /field/{allPaths=**} {
      allow read, write: if false;
    }

    match /fields/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
