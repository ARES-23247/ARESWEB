rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function authorizationData() {
      return get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data;
    }

    function isActiveRole(role) {
      // student, parent, and lead are temporary compatibility roles. All new
      // writes use member or mentor, and the server normalizes these values.
      return role in ['admin', 'coach', 'mentor', 'member', 'student', 'parent', 'lead'];
    }

    // Require a known role and an active authorization record. Unknown values
    // fail closed instead of becoming members by accident.
    function isAuthorized() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid)) &&
        isActiveRole(authorizationData().role) &&
        authorizationData().get('isDeleted', false) != true &&
        authorizationData().get('isDeleted', 0) != 1;
    }
    
    // Helper function to check if the user has a specific role (e.g. 'admin')
    function hasRole(role) {
      return isAuthorized() && 
        authorizationData().role == role;
    }

    function isContentPublisher() {
      return hasRole('admin') || hasRole('coach') || hasRole('mentor');
    }

    function isPendingContent(data) {
      return data.status in ['draft', 'pending', 'pending_approval'];
    }

    function contentOwnerId(collectionName, contentId) {
      return collectionName + '__' + contentId;
    }

    function isContentOwner(collectionName, contentId) {
      let ownerId = contentOwnerId(collectionName, contentId);
      return exists(/databases/$(database)/documents/content_owners/$(ownerId)) &&
        get(/databases/$(database)/documents/content_owners/$(ownerId)).data.ownerUid == request.auth.uid;
    }

    function isContentOwnerAfter(collectionName, contentId) {
      let ownerId = contentOwnerId(collectionName, contentId);
      return existsAfter(/databases/$(database)/documents/content_owners/$(ownerId)) &&
        getAfter(/databases/$(database)/documents/content_owners/$(ownerId)).data.ownerUid == request.auth.uid;
    }

    function canCreateContent(collectionName, contentId) {
      return isContentPublisher() || (
        isAuthorized() &&
        isPendingContent(request.resource.data) &&
        request.resource.data.get('isDeleted', 0) == 0 &&
        isContentOwnerAfter(collectionName, contentId)
      );
    }

    function canUpdateContent(collectionName, contentId) {
      return isContentPublisher() || (
        isAuthorized() &&
        isPendingContent(resource.data) &&
        isPendingContent(request.resource.data) &&
        isContentOwner(collectionName, contentId)
      );
    }

    // Reviewed documentation is saved as pending by browser clients. Only the
    // Admin SDK approval transaction may create the pending -> published
    // transition. A publisher may still archive/restore an already-approved
    // record without changing its reviewed content.
    function canCreatePendingDoc(docSlug) {
      return isPendingContent(request.resource.data) &&
        request.resource.data.get('approvalStatus', 'pending_approval') != 'approved' &&
        canCreateContent('docs', docSlug);
    }

    function canUpdatePendingDoc(docSlug) {
      return isPendingContent(request.resource.data) &&
        request.resource.data.get('approvalStatus', 'pending_approval') != 'approved' && (
          isContentPublisher() || (
            isAuthorized() &&
            isPendingContent(resource.data) &&
            isContentOwner('docs', docSlug)
          )
        );
    }

    function canChangeApprovedDocLifecycleOnly() {
      return isContentPublisher() &&
        resource.data.status == 'published' &&
        resource.data.get('approvalStatus', 'approved') == 'approved' &&
        request.resource.data.status == 'published' &&
        request.resource.data.get('approvalStatus', 'approved') == 'approved' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isDeleted', 'updatedAt'
        ]);
    }

    function canCreateRevision(collectionName, contentId) {
      return isAuthorized() &&
        request.resource.data.editedBy == request.auth.uid &&
        (isContentPublisher() || isContentOwnerAfter(collectionName, contentId));
    }

    function hasNoServerDriveFields() {
      return !request.resource.data.keys().hasAny([
        'source', 'driveFileId', 'driveName', 'driveMimeType',
        'driveModifiedTime', 'driveMd5Checksum', 'driveSyncState',
        'driveCheckedAt', 'driveImportedAt'
      ]);
    }

    function preservesServerDriveFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'source', 'driveFileId', 'driveName', 'driveMimeType',
        'driveModifiedTime', 'driveMd5Checksum', 'driveSyncState',
        'driveCheckedAt', 'driveImportedAt'
      ]);
    }

    function isCanonicalTaskCreate(taskId) {
      let data = request.resource.data;
      return taskId.size() > 0 && taskId.size() <= 160 &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'status', 'priority', 'subteam',
          'assignees', 'subtasks', 'archived', 'isDeleted', 'createdAt',
          'commentsCount', 'dueDate'
        ]) &&
        data.keys().hasAll([
          'id', 'title', 'description', 'status', 'priority', 'subteam',
          'assignees', 'subtasks', 'createdAt'
        ]) &&
        data.id == taskId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
        data.description is string && data.description.size() <= 20000 &&
        data.status in ['todo', 'in_progress', 'review', 'completed'] &&
        data.priority in ['low', 'medium', 'high'] &&
        data.subteam in ['software', 'hardware', 'business', 'outreach'] &&
        data.assignees is list && data.assignees.size() <= 50 &&
        data.subtasks is list && data.subtasks.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() <= 40 &&
        (data.get('dueDate', null) == null ||
          (data.dueDate is string &&
            data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        data.get('archived', false) is bool &&
        data.get('isDeleted', 0) in [0, 1] &&
        data.get('commentsCount', 0) is int &&
        data.get('commentsCount', 0) >= 0 &&
        data.get('commentsCount', 0) <= 1000000;
    }

    function isValidTaskUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return changed.hasOnly([
          'title', 'description', 'status', 'priority', 'subteam',
          'assignees', 'subtasks', 'archived', 'isDeleted', 'commentsCount',
          'dueDate'
        ]) &&
        (!changed.hasAny(['title']) ||
          (data.title is string && data.title.size() > 0 && data.title.size() <= 240)) &&
        (!changed.hasAny(['description']) ||
          (data.description is string && data.description.size() <= 20000)) &&
        (!changed.hasAny(['status']) ||
          data.status in ['todo', 'in_progress', 'review', 'completed']) &&
        (!changed.hasAny(['priority']) ||
          data.priority in ['low', 'medium', 'high']) &&
        (!changed.hasAny(['subteam']) ||
          data.subteam in ['software', 'hardware', 'business', 'outreach']) &&
        (!changed.hasAny(['assignees']) ||
          (data.assignees is list && data.assignees.size() <= 50)) &&
        (!changed.hasAny(['subtasks']) ||
          (data.subtasks is list && data.subtasks.size() <= 100)) &&
        (!changed.hasAny(['dueDate']) || data.dueDate == null ||
          (data.dueDate is string &&
            data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        (!changed.hasAny(['archived']) || data.archived is bool) &&
        (!changed.hasAny(['isDeleted']) || data.isDeleted in [0, 1]) &&
        (!changed.hasAny(['commentsCount']) ||
          (data.commentsCount is int && data.commentsCount >= 0 && data.commentsCount <= 1000000));
    }

    function isValidWebTaskComment(commentId) {
      let data = request.resource.data;
      return commentId.size() > 0 && commentId.size() <= 160 &&
        data.keys().hasOnly(['id', 'authorUid', 'author', 'content', 'source', 'createdAt']) &&
        data.keys().hasAll(['authorUid', 'content', 'source', 'createdAt']) &&
        (!data.keys().hasAny(['id']) || data.id == commentId) &&
        (!data.keys().hasAny(['author']) ||
          (data.author is string && data.author.size() <= 80)) &&
        data.authorUid == request.auth.uid &&
        data.source == 'web' &&
        data.content is string && data.content.size() > 0 && data.content.size() <= 4000 &&
        data.createdAt is string && data.createdAt.size() <= 40;
    }

    // Rules for the authorized_users collection
    match /authorized_users/{userId} {
      // Users can read their own registration doc; admins/coaches can read everything
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole('admin') || hasRole('coach'));
      // Bootstrap, invitations, and role changes use audited server-side APIs.
      allow write: if false;
    }

    // Private ownership records let rules enforce draft ownership without
    // placing stable Firebase UIDs in publicly readable content documents.
    match /content_owners/{ownerId} {
      allow read: if false;
      allow create: if isAuthorized() &&
        request.resource.data.keys().hasOnly(['collectionName', 'contentId', 'ownerUid', 'createdAt']) &&
        request.resource.data.keys().hasAll(['collectionName', 'contentId', 'ownerUid', 'createdAt']) &&
        request.resource.data.collectionName in ['posts', 'docs', 'documents'] &&
        request.resource.data.contentId is string &&
        request.resource.data.contentId.size() > 0 &&
        request.resource.data.contentId.size() <= 200 &&
        ownerId == contentOwnerId(request.resource.data.collectionName, request.resource.data.contentId) &&
        request.resource.data.ownerUid == request.auth.uid &&
        request.resource.data.createdAt is string &&
        request.resource.data.createdAt.size() <= 40 &&
        existsAfter(/databases/$(database)/documents/$(request.resource.data.collectionName)/$(request.resource.data.contentId));
      allow update, delete: if false;
    }

    // Public collections (blogs, calendar, knowledge base docs)
    match /posts/{postSlug} {
      // Public readers use the explicit /api/content DTO boundary.
      allow read: if isAuthorized();
      allow create: if canCreateContent('posts', postSlug);
      allow update: if canUpdateContent('posts', postSlug);
      allow delete: if isContentPublisher();

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if canCreateRevision('posts', postSlug);
        allow update, delete: if false;
      }
    }

    match /events/{eventId} {
      // Public pages use the explicit calendar DTO API. Members may read raw
      // records for team-only workflows, while all parent-document writes go
      // through the authenticated and audited Calendar API.
      allow read: if isAuthorized();
      allow create, update, delete: if false;

      match /signups/{userId} {
        allow read: if isAuthorized();
        allow write: if isAuthorized() && (request.auth.uid == userId || hasRole('admin') || hasRole('coach'));
      }

      match /photos/{photoId} {
        // Public consumers receive a bounded, metadata-stripped Calendar API DTO.
        allow read: if isAuthorized();
        // Association, approval, and archival use the audited Calendar API.
        allow write: if false;
      }

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow write: if isAuthorized();
      }
    }

    match /locations/{locationId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /imported_photos/{photoId} {
      allow read, write: if false;
    }

    match /albums/{albumId} {
      allow read, write: if false;
    }

    match /docs/{docSlug} {
      // Public readers use the explicit /api/content DTO boundary.
      allow read: if isAuthorized();
      allow create: if canCreatePendingDoc(docSlug);
      allow update: if canUpdatePendingDoc(docSlug) || canChangeApprovedDocLifecycleOnly();
      allow delete: if isContentPublisher();

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if canCreateRevision('docs', docSlug);
        allow update, delete: if false;
      }
    }

    // Approval records contain operational review metadata and are written by
    // the server transaction only.
    match /content_approval_audit/{auditId} {
      allow read, write: if false;
    }

    // Secure team collections (Kanban tasks and AI chat sessions)
    match /tasks/{taskId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && isCanonicalTaskCreate(taskId);
      // Validate only changed fields so malformed legacy fields can be preserved
      // while every new edit is canonical and bounded.
      allow update: if isAuthorized() && isValidTaskUpdate();
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isAuthorized();
        allow create: if isAuthorized() && isValidWebTaskComment(commentId);
        allow update: if isAuthorized() &&
          resource.data.authorUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content']) &&
          request.resource.data.content is string &&
          request.resource.data.content.size() > 0 &&
          request.resource.data.content.size() <= 4000;
        allow delete: if isAuthorized() && resource.data.authorUid == request.auth.uid;
      }

      // Client-written activity trail for the task board. Bounded to a fixed
      // action vocabulary and size limits; entries are immutable once written.
      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if isAuthorized() &&
          revisionId.size() > 0 && revisionId.size() <= 160 &&
          request.resource.data.keys().hasAll(['action', 'actorUid', 'actorName', 'createdAt']) &&
          request.resource.data.keys().hasOnly(['action', 'actorUid', 'actorName', 'createdAt', 'from', 'to', 'fields']) &&
          request.resource.data.action in ['created', 'updated', 'moved', 'archived', 'restored', 'deleted'] &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.actorName is string &&
          request.resource.data.actorName.size() <= 80 &&
          request.resource.data.createdAt is string &&
          request.resource.data.createdAt.size() <= 40 &&
          (!request.resource.data.keys().hasAny(['from']) ||
            (request.resource.data.from is string && request.resource.data.from.size() <= 40)) &&
          (!request.resource.data.keys().hasAny(['to']) ||
            (request.resource.data.to is string && request.resource.data.to.size() <= 40)) &&
          (!request.resource.data.keys().hasAny(['fields']) ||
            (request.resource.data.fields is list && request.resource.data.fields.size() <= 12));
        allow update, delete: if false;
      }
    }

    match /tournaments/{tournamentId} {
      allow read: if isAuthorized();
      allow write: if hasRole('admin') || hasRole('coach');
    }

    match /tournament_matches/{matchId} {
      allow read: if isAuthorized();
      allow write: if hasRole('admin') || hasRole('coach');
    }

    match /chat_sessions/{sessionId} {
      // Restrict read/write to the session owner only
      allow read: if isAuthorized() && resource.data.userId == request.auth.uid;
      allow create: if isAuthorized() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuthorized() && resource.data.userId == request.auth.uid;
    }

    // Public partners / sponsors
    match /sponsors/{sponsorId} {
      // Public consumers must use the filtered DTO API.
      allow read: if hasRole('admin') || hasRole('coach');
      allow write: if hasRole('admin');
    }

    // Public outreach logs
    match /outreach_logs/{logId} {
      // Public consumers must use the published, redacted DTO API.
      allow read: if hasRole('admin') || hasRole('coach');
      allow write: if false; // Only backend admin SDK can write
    }

    // inquiries (securely gated to adminDb server writes only!)
    match /inquiries/{inquiryId} {
      allow read: if hasRole('admin') || hasRole('coach');
      allow write: if false;
    }

    // user_profiles
    match /user_profiles/{userId} {
      // Profile documents contain encrypted youth contact and safety fields.
      // Subjects and administrators use explicit Cloud Function DTO APIs.
      allow read, create, update, delete: if false;

      match /layouts/{layoutId} {
        allow read, write: if isAuthorized() && request.auth.uid == userId;
      }
    }

    // Server-written administrative audit trail.
    match /audit_logs/{auditId} {
      allow read: if hasRole('admin') || hasRole('coach');
      allow write: if false;
    }

    // robots
    // Public consumers use the bounded robots DTO API; raw documents stay
    // team-only so fields outside the DTO can never leak publicly.
    match /robots/{robotId} {
      allow read: if isAuthorized();
      allow create: if (hasRole('admin') || hasRole('coach') || hasRole('mentor')) &&
                    request.resource.data.isDeleted == 0;
      allow update: if (hasRole('admin') || hasRole('coach') || hasRole('mentor')) &&
                    request.resource.data.isDeleted in [0, 1];
      // Fleet history is retained. Decommission and restore use the isDeleted flag.
      allow delete: if false;
    }

    // Runtime configuration is read and changed only through audited DTO APIs.
    match /settings/{settingId} {
      allow read, write: if false;
    }

    // Runtime settings and credentials are server-only.
    match /system_settings/{settingId} {
      allow read, write: if false;
    }

    // Pseudonymous abuse counters and compressed public artifacts are internal
    // Admin SDK implementation details, never browser data contracts.
    match /internal_api_quotas/{quotaId} {
      allow read, write: if false;
    }

    match /internal_public_artifacts/{artifactId} {
      allow read, write: if false;

      match /chunks/{chunkId} {
        allow read, write: if false;
      }
    }

    // Retired simulation field configuration. Historical records remain
    // server-inaccessible until a reviewed DTO API is introduced.
    match /field_configs/{configId} {
      allow read, write: if false;
    }

    // documents
    match /documents/{docId} {
      allow read: if isAuthorized();
      allow create: if hasNoServerDriveFields() && canCreateContent('documents', docId);
      allow update: if preservesServerDriveFields() && canUpdateContent('documents', docId);
      allow delete: if isContentPublisher();

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if canCreateRevision('documents', docId);
        allow update, delete: if false;
      }
    }

    // videos
    match /videos/{videoId} {
      allow read, write: if false;
    }

    // seasons
    match /seasons/{seasonId} {
      // Public readers use the explicit /api/seasons DTO boundary.
      allow read: if isAuthorized();
      allow create, update, delete: if isContentPublisher();
    }

    // awards
    match /awards/{awardId} {
      // Public readers use the explicit /api/awards DTO boundary.
      allow read: if isAuthorized();
      allow create, update, delete: if isContentPublisher();
    }


    // finance_transactions
    match /finance_transactions/{txId} {
      allow read: if hasRole('admin') || hasRole('coach') || hasRole('mentor');
      allow write: if hasRole('admin') || hasRole('coach') || hasRole('mentor');
    }

    // orders (team store checkout mock orders)
    match /orders/{orderId} {
      allow read: if hasRole('admin') || hasRole('coach') || hasRole('mentor');
      allow write: if false;
    }

    // judge_access_codes
    match /judge_access_codes/{codeId} {
      allow read: if hasRole('admin') || hasRole('coach') || hasRole('mentor');
      allow write: if hasRole('admin') || hasRole('coach');
    }

    // docs_feedback
    match /docs_feedback/{feedbackId} {
      allow create: if isAuthorized() &&
                    request.resource.data.keys().hasAll(['slug', 'isHelpful', 'comment', 'isResolved', 'createdAt']) &&
                    request.resource.data.keys().hasOnly(['slug', 'isHelpful', 'comment', 'isResolved', 'createdAt']) &&
                    request.resource.data.slug is string &&
                    request.resource.data.slug.size() <= 200 &&
                    (request.resource.data.isHelpful == 0 || request.resource.data.isHelpful == 1) &&
                    request.resource.data.comment is string &&
                    request.resource.data.comment.size() < 2000 &&
                    request.resource.data.isResolved == 0 &&
                    request.resource.data.createdAt is string &&
                    request.resource.data.createdAt.size() <= 40;
      allow read: if isAuthorized();
    }

    // team_layouts
    match /team_layouts/{layoutId} {
      allow read, write: if isAuthorized();
    }
  }
}

