rules_version = '2';

// ===============================================================
// Assumed Data Model & Security Boundaries
// ===============================================================
//
// Authority Source:
//   - authorized_users/{uid}: server-managed only (allow write: if false).
//     Active roles: admin, coach, mentor, member (plus legacy student/parent/lead),
//     with isDeleted != true and isDeleted != 1.
//
// Client-Writable Collections (validated with strict schemas & size limits):
//   - content_owners/{collectionName__contentId}: private atomic draft ownership
//     records (create-only, paired with new posts/docs/documents drafts).
//   - posts/{postSlug}, docs/{docSlug}, documents/{docId} + /revisions/{revisionId}:
//     team-managed content with pending-approval and publishedSnapshot staging,
//     plus immutable bounded revision history.
//   - events/{eventId}/signups/{userId}: member RSVPs (self-promotion of attended
//     denied; mentor/coach/admin roll call allowed).
//   - tasks/{taskId} + /comments/{commentId} + /revisions/{revisionId}:
//     team Kanban cards, author-bound web comments, and immutable activity logs.
//   - user_profiles/{userId}/layouts/{layoutId}: owner-only bounded column layouts.
//   - docs_feedback/{feedbackId}: authorized member documentation feedback (create-only).
//
// Server-Only / API-Owned Collections (Admin SDK via Express DTO APIs):
//   - inquiries, user_profiles, finance_transactions, settings, system_settings,
//     imported_photos, albums, videos, event_checkin_codes, content_approval_audit,
//     internal_api_quotas, game_*, studio_integration*, internal_public_artifacts,
//     field_configs, orders, judge_access_codes, chat_sessions, team_layouts, and
//     all unlisted paths via the explicit catch-all deny.
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function authorizationData() {
      return get(/databases/$(database)/documents/authorized_users/$(request.auth.uid)).data;
    }

    function isActiveRole(role) {
      // student, parent, and lead are temporary compatibility roles. All new
      // writes use member or mentor, and the server normalizes these values.
      return role in ['admin', 'coach', 'mentor', 'member', 'student', 'parent', 'lead'];
    }

    function isActiveAuthorizationData(authData) {
      return isActiveRole(authData.get('role', '')) &&
        authData.get('isDeleted', false) != true &&
        authData.get('isDeleted', 0) != 1;
    }

    // Require a known role and an active authorization record. Unknown values
    // fail closed instead of becoming members by accident.
    function isAuthorized() {
      return isAuthenticated() &&
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.uid)) &&
        isActiveAuthorizationData(authorizationData());
    }
    
    // Helper function to check if the user has a specific role (e.g. 'admin')
    function hasRole(role) {
      return isAuthorized() && 
        authorizationData().get('role', '') == role;
    }

    function hasActivePublisherRole() {
      return authorizationData().get('role', '') in ['admin', 'coach', 'mentor'];
    }

    function isContentPublisher() {
      return isAuthorized() && hasActivePublisherRole();
    }

    function optStr(val, maxLen) {
      return val is string && val.size() <= maxLen;
    }

    // Bounded string-list validator using list.join() so total payload size stays
    // strictly capped in O(1) rule expressions while rejecting non-string endpoints
    // and nested maps/lists at any index.
    function isBoundedStringList(items, maxItems, maxTotalChars) {
      return items is list &&
        items.size() <= maxItems &&
        items.join(',').size() <= maxTotalChars &&
        (items.size() == 0 || (items[0] is string && items[items.size() - 1] is string));
    }

    function isPendingContent(data) {
      return data.status in ['draft', 'pending', 'pending_approval'];
    }

    function isPendingOrStagedContent(data) {
      return isPendingContent(data) || (
        data.status == 'published' &&
        data.get('approvalStatus', '') == 'pending_approval' &&
        data.get('publishedSnapshot', null) is map
      );
    }

    // Explicit allowlist of public content, media, and learning fields that may
    // appear in publishedSnapshot. Mapping every allowlisted key to null lets
    // snap.diff(emptySnap).changedKeys() identify non-null snapshot fields in
    // O(1) without expanding 46 per-field predicates.
    function emptyPublishedSnapshot() {
      return {
        'title': null,
        'content': null,
        'summary': null,
        'category': null,
        'library': null,
        'slug': null,
        'author': null,
        'coverImage': null,
        'fileUrl': null,
        'fileName': null,
        'fileType': null,
        'mediaPhotoIds': null,
        'snippet': null,
        'thumbnail': null,
        'authorAvatar': null,
        'date': null,
        'description': null,
        'sortOrder': null,
        'displayInAreslib': null,
        'displayInMathCorner': null,
        'displayInScienceCorner': null,
        'isPortfolio': null,
        'isExecutiveSummary': null,
        'original_authorNickname': null,
        'original_authorAvatar': null,
        'searchIndexable': null,
        'learningSchemaVersion': null,
        'subject': null,
        'topics': null,
        'contentType': null,
        'level': null,
        'estimatedMinutes': null,
        'pathMemberships': null,
        'prerequisites': null,
        'objectives': null,
        'platforms': null,
        'sourceReferences': null,
        'appliesToVersion': null,
        'reviewedAt': null,
        'reviewedByLabel': null,
        'safetyScope': null,
        'instructionalContractVersion': null,
        'createdAt': null,
        'updatedAt': null,
        'publishedAt': null,
        'datePublished': null,
      };
    }

    function matchesPublishedSnapshotInitialState(snap, prev, emptySnap) {
      let snapDiff = snap.diff(prev);
      return snapDiff.changedKeys().size() == 0 &&
        snap.diff(emptySnap).changedKeys().difference(snapDiff.unchangedKeys()).size() == 0;
    }

    function hasValidPublishedSnapshotWithAllowlist(emptySnap) {
      let allowedKeys = emptySnap.keys();
      let prev = resource.data;
      let next = request.resource.data;
      let snap = next.get('publishedSnapshot', null);
      return prev.get('status', '') == 'published' &&
        next.get('status', '') == 'published' &&
        next.get('approvalStatus', '') == 'pending_approval' &&
        snap is map &&
        snap.keys().hasOnly(allowedKeys) &&
        // Because resolvePublishedContentData() merges { ...data, ...publishedSnapshot },
        // no public/media/learning field may change on the root document unless
        // that field is explicitly shadowed inside publishedSnapshot.
        !next.diff(prev).affectedKeys().difference(snap.keys().toSet()).hasAny(allowedKeys) &&
        // Defense-in-depth for webRendering.ts, which checks raw searchIndexable
        // before resolving publishedSnapshot; staged edits may not flip it.
        next.get('searchIndexable', null) == prev.get('searchIndexable', null) && (
          (
            prev.get('approvalStatus', 'approved') == 'pending_approval' &&
            prev.get('publishedSnapshot', null) is map &&
            snap == prev.publishedSnapshot
          ) || (
            prev.get('approvalStatus', 'approved') != 'pending_approval' &&
            matchesPublishedSnapshotInitialState(snap, prev, emptySnap)
          )
        );
    }

    function hasValidPublishedSnapshotOnPendingUpdate() {
      return hasValidPublishedSnapshotWithAllowlist(emptyPublishedSnapshot());
    }

    function contentOwnerId(collectionName, contentId) {
      return collectionName + '__' + contentId;
    }

    function isContentOwner(collectionName, contentId) {
      let ownerId = contentOwnerId(collectionName, contentId);
      return exists(/databases/$(database)/documents/content_owners/$(ownerId)) &&
        get(/databases/$(database)/documents/content_owners/$(ownerId)).data.ownerUid == request.auth.uid;
    }

    function isContentOwnerAfter(collectionName, contentId) {
      let ownerId = contentOwnerId(collectionName, contentId);
      return existsAfter(/databases/$(database)/documents/content_owners/$(ownerId)) &&
        getAfter(/databases/$(database)/documents/content_owners/$(ownerId)).data.ownerUid == request.auth.uid;
    }

    function isSafeMemberApprovalFields(data) {
      return data.get('approvalStatus', 'pending_approval') != 'approved' &&
        data.get('isApproved', false) == false &&
        !('approvedBy' in data) &&
        !('approvedAt' in data) &&
        !('approvedByUid' in data) &&
        !('approvedByRole' in data);
    }

    function isSafeMemberPendingFields(data) {
      return isPendingContent(data) &&
        !('publishedSnapshot' in data) &&
        isSafeMemberApprovalFields(data);
    }

    function isSafeMemberPendingUpdateFields(data) {
      return (
          (
            resource.data.get('status', '') != 'published' &&
            isPendingContent(data) &&
            !('publishedSnapshot' in data)
          ) ||
          hasValidPublishedSnapshotOnPendingUpdate()
        ) &&
        isSafeMemberApprovalFields(data);
    }

    function isSafeMemberPendingOrStagedData(data) {
      return isPendingOrStagedContent(data) &&
        isSafeMemberApprovalFields(data);
    }

    function isSafeMemberDraftWrite(data) {
      return isSafeMemberPendingFields(data) &&
        (!('authorId' in data) || data.authorId == request.auth.uid);
    }

    function preservesOrBindsAuthorId() {
      return 'authorId' in resource.data
        ? request.resource.data.get('authorId', null) == resource.data.authorId
        : (!('authorId' in request.resource.data) || request.resource.data.authorId == request.auth.uid);
    }

    function isActiveMemberEditorOnPost() {
      return request.resource.data.get('lastEditedByUid', '') is string &&
        request.resource.data.get('lastEditedByUid', '') == request.auth.uid;
    }

    function hasPriorCollaborativePostState() {
      return (
        resource.data.get('lastEditedByUid', '') is string &&
        resource.data.get('lastEditedByUid', '').size() > 0
      ) || resource.data.get('importedFrom', '') == 'ares-robotics-studio';
    }

    function canCreateContent(collectionName, contentId) {
      return isContentPublisher() || (
        isAuthorized() &&
        isSafeMemberDraftWrite(request.resource.data) &&
        request.resource.data.get('isDeleted', 0) == 0 &&
        isContentOwnerAfter(collectionName, contentId)
      );
    }

    function canMemberEditContentRecord(collectionName, contentId) {
      return isAuthorized() &&
        resource.data.get('isDeleted', 0) == 0 &&
        request.resource.data.get('isDeleted', 0) == resource.data.get('isDeleted', 0) &&
        preservesOrBindsAuthorId() &&
        request.resource.data.get('importedFrom', null) == resource.data.get('importedFrom', null) &&
        (
          isContentOwner(collectionName, contentId) ||
          (resource.data.get('status', '') == 'published' && isActiveMemberEditorOnPost()) ||
          (isPendingOrStagedContent(resource.data) && hasPriorCollaborativePostState() && isActiveMemberEditorOnPost())
        );
    }

    function canUpdateContent(collectionName, contentId) {
      return isContentPublisher() || (
        canMemberEditContentRecord(collectionName, contentId) &&
        isSafeMemberPendingUpdateFields(request.resource.data)
      );
    }

    function canUpdatePost(postSlug) {
      return canUpdateContent('posts', postSlug);
    }

    // Reviewed documentation is saved as pending by browser clients. Only the
    // Admin SDK approval transaction may create the pending -> published
    // transition. A publisher may still archive/restore an already-approved
    // record without changing its reviewed content.
    function canCreatePendingDoc(docSlug) {
      return isPendingContent(request.resource.data) &&
        !('publishedSnapshot' in request.resource.data) &&
        request.resource.data.get('approvalStatus', 'pending_approval') != 'approved' &&
        canCreateContent('docs', docSlug);
    }

    function canUpdatePendingDoc(docSlug) {
      let publisher = isContentPublisher();
      return (
          (
            (publisher || resource.data.get('status', '') != 'published') &&
            isPendingContent(request.resource.data) &&
            !('publishedSnapshot' in request.resource.data)
          ) ||
          hasValidPublishedSnapshotOnPendingUpdate()
        ) &&
        request.resource.data.get('approvalStatus', 'pending_approval') != 'approved' && (
          publisher || (
            isSafeMemberApprovalFields(request.resource.data) &&
            canMemberEditContentRecord('docs', docSlug)
          )
        );
    }

    function canChangeApprovedDocLifecycleOnly() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isContentPublisher() &&
        resource.data.status == 'published' &&
        resource.data.get('approvalStatus', 'approved') == 'approved' &&
        request.resource.data.status == 'published' &&
        request.resource.data.get('approvalStatus', 'approved') == 'approved' &&
        changed.hasOnly(['isDeleted', 'updatedAt']) &&
        (!changed.hasAny(['isDeleted']) ||
          (request.resource.data.isDeleted is int && request.resource.data.isDeleted in [0, 1])) &&
        (!changed.hasAny(['updatedAt']) ||
          (request.resource.data.updatedAt is string &&
            request.resource.data.updatedAt.size() > 0 &&
            request.resource.data.updatedAt.size() <= 40));
    }

    function isValidContentRevision(revisionId) {
      let data = request.resource.data;
      return revisionId.size() > 0 && revisionId.size() <= 160 &&
        data.keys().hasAll(['editedBy', 'timestamp']) &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'content', 'category', 'sortOrder',
          'status', 'displayInAreslib', 'displayInMathCorner',
          'displayInScienceCorner', 'isPortfolio', 'isExecutiveSummary',
          'fileUrl', 'createdAt', 'author', 'date', 'thumbnail',
          'mediaPhotoIds', 'learningSchemaVersion', 'metadataStatus',
          'subject', 'topics', 'contentType', 'level', 'estimatedMinutes',
          'pathMemberships', 'prerequisites', 'objectives', 'platforms',
          'sourceReferences', 'appliesToVersion', 'reviewedAt',
          'reviewedByLabel', 'safetyScope', 'editedBy', 'editedByName',
          'editedByAvatar', 'timestamp'
        ]) &&
        data.editedBy is string && data.editedBy == request.auth.uid &&
        data.timestamp is string && data.timestamp.size() > 0 && data.timestamp.size() <= 60 &&
        data.get('id', revisionId) == revisionId &&
        optStr(data.get('title', ''), 300) &&
        optStr(data.get('description', ''), 5000) &&
        optStr(data.get('content', ''), 750000) &&
        optStr(data.get('category', ''), 160) &&
        optStr(data.get('status', ''), 40) &&
        optStr(data.get('fileUrl', ''), 2000) &&
        optStr(data.get('author', ''), 200) &&
        optStr(data.get('thumbnail', ''), 2000) &&
        optStr(data.get('editedByName', ''), 160) &&
        optStr(data.get('editedByAvatar', ''), 2000) &&
        // String concatenation in CEL requires every operand to be a string (no coercion),
        // validating all 9 short metadata strings' types and total length in O(1).
        (data.get('createdAt', '') + data.get('date', '') + data.get('subject', '') +
          data.get('contentType', '') + data.get('level', '') + data.get('appliesToVersion', '') +
          data.get('reviewedAt', '') + data.get('reviewedByLabel', '') + data.get('safetyScope', '')).size() <= 1080 &&
        data.get('metadataStatus', 'complete') in ['complete', 'legacy-inferred'] &&
        [
          data.get('displayInAreslib', 0),
          data.get('displayInMathCorner', 0),
          data.get('displayInScienceCorner', 0),
          data.get('isPortfolio', 0),
          data.get('isExecutiveSummary', 0),
          data.get('learningSchemaVersion', 0)
        ].toSet().hasOnly([0, 1]) &&
        data.get('sortOrder', 0) is number &&
        data.get('sortOrder', 0) >= -10000 && data.get('sortOrder', 0) <= 100000 &&
        data.get('estimatedMinutes', 1) is int &&
        data.get('estimatedMinutes', 1) >= 1 && data.get('estimatedMinutes', 1) <= 600 &&
        isBoundedStringList(data.get('mediaPhotoIds', []), 100, 30100) &&
        isBoundedStringList(data.get('topics', []), 20, 1620) &&
        isBoundedStringList(data.get('prerequisites', []), 20, 6020) &&
        isBoundedStringList(data.get('objectives', []), 20, 10020) &&
        isBoundedStringList(data.get('platforms', []), 10, 410) &&
        data.get('pathMemberships', []) is list && data.get('pathMemberships', []).size() <= 30 &&
        data.get('sourceReferences', []) is list && data.get('sourceReferences', []).size() <= 20;
    }

    function canCreateRevision(collectionName, contentId, revisionId) {
      return isAuthorized() &&
        isValidContentRevision(revisionId) &&
        existsAfter(/databases/$(database)/documents/$(collectionName)/$(contentId)) && (
          hasActivePublisherRole() ||
          isContentOwnerAfter(collectionName, contentId) || (
            isSafeMemberPendingOrStagedData(getAfter(/databases/$(database)/documents/$(collectionName)/$(contentId)).data) &&
            getAfter(/databases/$(database)/documents/$(collectionName)/$(contentId)).data.get('lastEditedByUid', '') == request.auth.uid
          )
        );
    }

    function canCreatePostRevision(postSlug, revisionId) {
      return canCreateRevision('posts', postSlug, revisionId);
    }

    function hasNoServerDriveFields() {
      return !request.resource.data.keys().hasAny([
        'source', 'driveFileId', 'driveName', 'driveMimeType',
        'driveModifiedTime', 'driveMd5Checksum', 'driveSyncState',
        'driveCheckedAt', 'driveImportedAt'
      ]);
    }

    function preservesServerDriveFields() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'source', 'driveFileId', 'driveName', 'driveMimeType',
        'driveModifiedTime', 'driveMd5Checksum', 'driveSyncState',
        'driveCheckedAt', 'driveImportedAt'
      ]);
    }

    function isCanonicalTaskCreate(taskId) {
      let data = request.resource.data;
      return taskId.size() > 0 && taskId.size() <= 160 &&
        data.keys().hasOnly([
          'id', 'title', 'description', 'status', 'priority', 'subteam',
          'assignees', 'subtasks', 'archived', 'isDeleted', 'createdAt',
          'commentsCount', 'dueDate'
        ]) &&
        data.keys().hasAll([
          'id', 'title', 'description', 'status', 'priority', 'subteam',
          'assignees', 'subtasks', 'createdAt'
        ]) &&
        data.id is string && data.id == taskId &&
        data.title is string && data.title.size() > 0 && data.title.size() <= 240 &&
        data.description is string && data.description.size() <= 20000 &&
        data.status in ['todo', 'in_progress', 'review', 'completed'] &&
        data.priority in ['low', 'medium', 'high'] &&
        data.subteam in ['software', 'hardware', 'business', 'outreach'] &&
        isBoundedStringList(data.assignees, 50, 6450) &&
        data.subtasks is list && data.subtasks.size() <= 100 &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
        (data.get('dueDate', null) == null ||
          (data.dueDate is string &&
            data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        data.get('archived', false) is bool &&
        data.get('isDeleted', 0) is int && data.get('isDeleted', 0) in [0, 1] &&
        data.get('commentsCount', 0) is int &&
        data.get('commentsCount', 0) >= 0 &&
        data.get('commentsCount', 0) <= 1000000;
    }

    function isValidTaskUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let data = request.resource.data;
      return changed.hasOnly([
          'title', 'description', 'status', 'priority', 'subteam',
          'assignees', 'subtasks', 'archived', 'isDeleted', 'commentsCount',
          'dueDate'
        ]) &&
        (!changed.hasAny(['title']) ||
          (data.title is string && data.title.size() > 0 && data.title.size() <= 240)) &&
        (!changed.hasAny(['description']) ||
          (data.description is string && data.description.size() <= 20000)) &&
        (!changed.hasAny(['status']) ||
          data.status in ['todo', 'in_progress', 'review', 'completed']) &&
        (!changed.hasAny(['priority']) ||
          data.priority in ['low', 'medium', 'high']) &&
        (!changed.hasAny(['subteam']) ||
          data.subteam in ['software', 'hardware', 'business', 'outreach']) &&
        (!changed.hasAny(['assignees']) ||
          isBoundedStringList(data.assignees, 50, 6450)) &&
        (!changed.hasAny(['subtasks']) ||
          (data.subtasks is list && data.subtasks.size() <= 100)) &&
        (!changed.hasAny(['dueDate']) || data.dueDate == null ||
          (data.dueDate is string &&
            data.dueDate.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))) &&
        (!changed.hasAny(['archived']) || data.archived is bool) &&
        (!changed.hasAny(['isDeleted']) || (data.isDeleted is int && data.isDeleted in [0, 1])) &&
        (!changed.hasAny(['commentsCount']) ||
          (data.commentsCount is int && data.commentsCount >= 0 && data.commentsCount <= 1000000));
    }

    function isValidWebTaskComment(commentId) {
      let data = request.resource.data;
      return commentId.size() > 0 && commentId.size() <= 160 &&
        data.keys().hasOnly(['id', 'authorUid', 'author', 'content', 'source', 'createdAt']) &&
        data.keys().hasAll(['authorUid', 'content', 'source', 'createdAt']) &&
        (!data.keys().hasAny(['id']) || (data.id is string && data.id == commentId)) &&
        (!data.keys().hasAny(['author']) ||
          (data.author is string && data.author.size() <= 80)) &&
        data.authorUid is string && data.authorUid == request.auth.uid &&
        data.source == 'web' &&
        data.content is string && data.content.size() > 0 && data.content.size() <= 4000 &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40;
    }

    function isValidTaskRevisionCreate(revisionId) {
      let data = request.resource.data;
      return revisionId.size() > 0 && revisionId.size() <= 160 &&
        data.keys().hasAll(['action', 'actorUid', 'actorName', 'createdAt']) &&
        data.keys().hasOnly(['action', 'actorUid', 'actorName', 'createdAt', 'from', 'to', 'fields']) &&
        data.action in ['created', 'updated', 'moved', 'archived', 'restored', 'deleted'] &&
        data.actorUid is string && data.actorUid == request.auth.uid &&
        data.actorName is string && data.actorName.size() <= 80 &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
        (!('from' in data) || (data.from is string && data.from.size() <= 40)) &&
        (!('to' in data) || (data.to is string && data.to.size() <= 40)) &&
        (!('fields' in data) || isBoundedStringList(data.fields, 12, 972));
    }

    function isValidContentOwnerCreate(ownerId) {
      let data = request.resource.data;
      return ownerId.size() > 0 && ownerId.size() <= 220 &&
        data.keys().hasOnly(['collectionName', 'contentId', 'ownerUid', 'createdAt']) &&
        data.keys().hasAll(['collectionName', 'contentId', 'ownerUid', 'createdAt']) &&
        data.collectionName in ['posts', 'docs', 'documents'] &&
        data.contentId is string && data.contentId.size() > 0 && data.contentId.size() <= 200 &&
        ownerId == contentOwnerId(data.collectionName, data.contentId) &&
        data.ownerUid is string && data.ownerUid == request.auth.uid &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40 &&
        !exists(/databases/$(database)/documents/$(data.collectionName)/$(data.contentId)) &&
        existsAfter(/databases/$(database)/documents/$(data.collectionName)/$(data.contentId));
    }

    function isValidEventSignup(eventId, userId) {
      let data = request.resource.data;
      return eventId.size() > 0 && eventId.size() <= 160 &&
        exists(/databases/$(database)/documents/events/$(eventId)) &&
        userId.size() > 0 && userId.size() <= 128 &&
        data.keys().size() > 0 &&
        data.keys().hasOnly(['userId', 'nickname', 'bringing', 'prepHours', 'notes', 'attended']) &&
        (!('userId' in data) || (data.userId is string && data.userId == userId)) &&
        (!('nickname' in data) || (data.nickname is string && data.nickname.size() <= 100)) &&
        (!('bringing' in data) || (data.bringing is string && data.bringing.size() <= 300)) &&
        (!('prepHours' in data) || (data.prepHours is number && data.prepHours >= 0 && data.prepHours <= 500)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 1000)) &&
        (!('attended' in data) || data.attended is bool);
    }

    function isValidUserLayout(layoutId) {
      let data = request.resource.data;
      return layoutId.size() > 0 && layoutId.size() <= 80 &&
        data.keys().hasOnly(['columns', 'updatedAt']) &&
        data.keys().hasAll(['columns']) &&
        isBoundedStringList(data.columns, 50, 4050) &&
        (!('updatedAt' in data) || (data.updatedAt is string && data.updatedAt.size() > 0 && data.updatedAt.size() <= 40));
    }

    function isValidDocsFeedbackCreate(feedbackId) {
      let data = request.resource.data;
      return feedbackId.size() > 0 && feedbackId.size() <= 160 &&
        data.keys().hasAll(['slug', 'isHelpful', 'comment', 'isResolved', 'createdAt']) &&
        data.keys().hasOnly(['slug', 'isHelpful', 'comment', 'isResolved', 'createdAt']) &&
        data.slug is string && data.slug.size() > 0 && data.slug.size() <= 200 &&
        data.isHelpful is int && data.isHelpful in [0, 1] &&
        data.comment is string && data.comment.size() < 2000 &&
        data.isResolved is int && data.isResolved == 0 &&
        data.createdAt is string && data.createdAt.size() > 0 && data.createdAt.size() <= 40;
    }

    // Rules for the authorized_users collection
    match /authorized_users/{userId} {
      // Users can read their own registration doc; admins/coaches can read everything
      allow read: if isAuthenticated() && (request.auth.uid == userId || hasRole('admin') || hasRole('coach'));
      // Bootstrap, invitations, and role changes use audited server-side APIs.
      allow write: if false;
    }

    // Private ownership records let rules enforce draft ownership without
    // placing stable Firebase UIDs in publicly readable content documents.
    match /content_owners/{ownerId} {
      allow read: if false;
      allow create: if isAuthorized() && isValidContentOwnerCreate(ownerId);
      allow update, delete: if false;
    }

    // Public collections (blogs, calendar, knowledge base docs)
    match /posts/{postSlug} {
      // Public readers use the explicit /api/content DTO boundary.
      allow read: if isAuthorized();
      allow create: if canCreateContent('posts', postSlug);
      allow update: if canUpdatePost(postSlug);
      allow delete: if isContentPublisher();

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if canCreatePostRevision(postSlug, revisionId);
        allow update, delete: if false;
      }
    }

    match /events/{eventId} {
      // Public pages use the explicit calendar DTO API. Members may read raw
      // records for team-only workflows, while all parent-document writes go
      // through the authenticated and audited Calendar API.
      allow read: if isAuthorized();
      allow create, update, delete: if false;

      match /signups/{userId} {
        allow read: if isAuthorized();
        allow create: if isAuthorized() &&
          isValidEventSignup(eventId, userId) && (
            isContentPublisher() || (
              request.auth.uid == userId &&
              (!('attended' in request.resource.data) || request.resource.data.attended == false)
            )
          );
        allow update: if isAuthorized() &&
          isValidEventSignup(eventId, userId) &&
          (!('userId' in resource.data) || request.resource.data.get('userId', null) == resource.data.userId) && (
            isContentPublisher() || (
              request.auth.uid == userId && (
                !('attended' in request.resource.data) ||
                request.resource.data.attended == false ||
                ('attended' in resource.data && request.resource.data.attended == resource.data.attended)
              )
            )
          );
        allow delete: if isAuthorized() && (
          request.auth.uid == userId ||
          isContentPublisher()
        );
      }

      match /photos/{photoId} {
        // Public consumers receive a bounded, metadata-stripped Calendar API DTO.
        allow read: if isAuthorized();
        // Association, approval, and archival use the audited Calendar API.
        allow write: if false;
      }

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        // Server-written audit history: only the audited Calendar API (Admin
        // SDK) records revisions. Browser clients may never forge or erase it.
        allow create, update, delete: if false;
      }
    }

    match /locations/{locationId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /imported_photos/{photoId} {
      allow read, write: if false;
    }

    match /event_checkin_codes/{eventId} {
      allow read, write: if false;
    }

    match /albums/{albumId} {
      allow read, write: if false;
    }

    match /docs/{docSlug} {
      // Public readers use the explicit /api/content DTO boundary.
      allow read: if isAuthorized();
      allow create: if canCreatePendingDoc(docSlug);
      allow update: if canUpdatePendingDoc(docSlug) || canChangeApprovedDocLifecycleOnly();
      allow delete: if isContentPublisher();

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if canCreateRevision('docs', docSlug, revisionId);
        allow update, delete: if false;
      }
    }

    // Approval records contain operational review metadata and are written by
    // the server transaction only.
    match /content_approval_audit/{auditId} {
      allow read, write: if false;
    }

    // Secure team collections (Kanban tasks and AI chat sessions)
    match /tasks/{taskId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && isCanonicalTaskCreate(taskId);
      // Validate only changed fields so malformed legacy fields can be preserved
      // while every new edit is canonical and bounded.
      allow update: if isAuthorized() && isValidTaskUpdate();
      allow delete: if false;

      match /comments/{commentId} {
        allow read: if isAuthorized();
        allow create: if isAuthorized() && isValidWebTaskComment(commentId);
        allow update: if isAuthorized() &&
          resource.data.get('authorUid', '') == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['content']) &&
          isValidWebTaskComment(commentId);
        allow delete: if isAuthorized() && resource.data.get('authorUid', '') == request.auth.uid;
      }

      // Client-written activity trail for the task board. Bounded to a fixed
      // action vocabulary and size limits; entries are immutable once written.
      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if isAuthorized() && isValidTaskRevisionCreate(revisionId);
        allow update, delete: if false;
      }
    }

    match /tournaments/{tournamentId} {
      // Public competition results use /api/tournaments/public/results;
      // team reads and admin/coach mutations use /api/tournaments.
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /tournament_matches/{matchId} {
      // Match schedules, scores, and checklists are mutated via /api/tournaments.
      allow read: if isAuthorized();
      allow write: if false;
    }

    // Retired/unused: no live client or server consumer. Reintroduce with a
    // validated schema when a feature ships. Admin SDK access is unaffected.
    match /chat_sessions/{sessionId} {
      allow read, write: if false;
    }

    // Public partners / sponsors
    match /sponsors/{sponsorId} {
      // Public consumers and admin mutations must use the /api/sponsors DTO API.
      allow read: if hasRole('admin') || hasRole('coach');
      allow write: if false;
    }

    // Public outreach logs
    match /outreach_logs/{logId} {
      // Public consumers must use the published, redacted DTO API.
      allow read: if hasRole('admin') || hasRole('coach');
      allow write: if false; // Only backend admin SDK can write
    }

    // inquiries (encrypted PII and metadata are server-only via /api/inquiries)
    match /inquiries/{inquiryId} {
      allow read, write: if false;
    }

    // user_profiles
    match /user_profiles/{userId} {
      // Profile documents contain encrypted youth contact and safety fields.
      // Subjects and administrators use explicit Cloud Function DTO APIs.
      allow read, create, update, delete: if false;

      match /layouts/{layoutId} {
        allow read, delete: if isAuthorized() && request.auth.uid == userId;
        allow create, update: if isAuthorized() &&
          request.auth.uid == userId &&
          isValidUserLayout(layoutId);
      }
    }

    // Server-written administrative audit trail.
    match /audit_logs/{auditId} {
      allow read: if hasRole('admin') || hasRole('coach');
      allow write: if false;
    }

    // robots
    // Public consumers use the bounded robots DTO API; raw documents stay
    // team-only so fields outside the DTO can never leak publicly.
    match /robots/{robotId} {
      allow read: if isAuthorized();
      // All robot mutations and fleet lifecycle actions route through the
      // /api/robots Express DTO APIs.
      allow write: if false;
    }

    // Runtime configuration is read and changed only through audited DTO APIs.
    match /settings/{settingId} {
      allow read, write: if false;
    }

    // Runtime settings and credentials are server-only.
    match /system_settings/{settingId} {
      allow read, write: if false;
    }

    // Pseudonymous abuse counters and compressed public artifacts are internal
    // Admin SDK implementation details, never browser data contracts.
    match /internal_api_quotas/{quotaId} {
      allow read, write: if false;
    }

    // Online game state, per-player capability hashes, and invite/matchmaking
    // mappings are server-only. Browsers use player-specific bounded DTO APIs.
    match /game_matches/{gameId} {
      allow read, write: if false;
    }

    match /game_invites/{inviteHash} {
      allow read, write: if false;
    }

    match /game_matchmaking/{slotId} {
      allow read, write: if false;
    }

    // Robot Studio installations, rate counters, and idempotency receipts are
    // server-to-server integration state and must never be browser-readable.
    match /studio_integrations/{installationId} {
      allow read, write: if false;
    }

    match /studio_integration_quotas/{quotaId} {
      allow read, write: if false;
    }

    match /studio_integration_receipts/{receiptId} {
      allow read, write: if false;
    }

    match /internal_public_artifacts/{artifactId} {
      allow read, write: if false;

      match /chunks/{chunkId} {
        allow read, write: if false;
      }
    }

    // Retired simulation field configuration. Historical records remain
    // server-inaccessible until a reviewed DTO API is introduced.
    match /field_configs/{configId} {
      allow read, write: if false;
    }

    // documents
    match /documents/{docId} {
      allow read: if isAuthorized();
      allow create: if hasNoServerDriveFields() && canCreateContent('documents', docId);
      allow update: if preservesServerDriveFields() && canUpdateContent('documents', docId);
      allow delete: if isContentPublisher();

      match /revisions/{revisionId} {
        allow read: if isAuthorized();
        allow create: if canCreateRevision('documents', docId, revisionId);
        allow update, delete: if false;
      }
    }

    // videos
    match /videos/{videoId} {
      allow read, write: if false;
    }

    // seasons
    match /seasons/{seasonId} {
      // Public readers use the explicit /api/seasons DTO boundary. All season
      // mutations, archival, and restore actions route through the
      // /api/seasons/admin Express DTO APIs (supporting admin/coach/mentor).
      allow read: if isAuthorized();
      allow write: if false;
    }

    // awards
    match /awards/{awardId} {
      // Public readers use the explicit /api/awards DTO boundary. All award
      // mutations, archival, restore, and permanent deletion of archived awards
      // route through the /api/awards/admin Express DTO APIs.
      allow read: if isAuthorized();
      allow write: if false;
    }


    // finance_transactions
    match /finance_transactions/{txId} {
      // Receipts, validation, recorder identity, and archival are API-owned.
      allow read, write: if false;
    }

    // orders: retired/unused. Reintroduce with a validated schema when a
    // feature ships. Admin SDK access is unaffected.
    match /orders/{orderId} {
      allow read, write: if false;
    }

    // judge_access_codes: retired/unused. Reintroduce with a validated schema
    // when a feature ships. Admin SDK access is unaffected.
    match /judge_access_codes/{codeId} {
      allow read, write: if false;
    }

    // docs_feedback
    match /docs_feedback/{feedbackId} {
      allow read: if isAuthorized();
      allow create: if isAuthorized() && isValidDocsFeedbackCreate(feedbackId);
      allow update, delete: if false;
    }

    // team_layouts: retired/unused. Reintroduce with a validated schema when a
    // feature ships. Admin SDK access is unaffected.
    match /team_layouts/{layoutId} {
      allow read, write: if false;
    }

    // Explicit default-deny catch-all for any unlisted collection or subcollection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

