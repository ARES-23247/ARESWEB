{
  "name": "functions",
  "scripts": {
    "gcp-build": "",
    "lint": "eslint src --max-warnings=0",
    "build": "node ../scripts/prepare-game-packages.mjs && node -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run serve",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:emulator": "vitest run --config vitest.emulator.config.ts",
    "studio:provision": "node scripts/provision-studio-integration.mjs"
  },
  "engines": {
    "node": "24"
  },
  "main": "lib/index.js",
  "dependencies": {
    "@google/genai": "2.21.0",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2",
    "google-auth-library": "^10.9.1",
    "planck": "^1.4.2",
    "sharp": "0.35.5",
    "ws": "^8.18.3",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.1",
    "@grpc/grpc-js": "~1.14.5",
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "body-parser": "^1.20.9",
    "brace-expansion": "^5.0.12",
    "fast-uri": "^3.1.9",
    "glob": "^14.0.2",
    "hono": "^4.13.11",
    "ip-address": "^10.7.4",
    "minimatch": "^11.0.1",
    "proxy-addr": "^2.0.8",
    "qs": "^6.16.1",
    "re2js": "^2.8.7",
    "rolldown": "1.2.5",
    "source-map-js": "^1.2.2",
    "uuid": "^11.1.1",
    "vite": "^8.2.4",
    "zod": "^4.6.6"
  },
  "private": true
}
