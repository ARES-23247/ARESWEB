FROM node:24.18.0-bookworm-slim AS build

WORKDIR /workspace/functions
COPY functions/package.json functions/package-lock.json ./
RUN npm ci
COPY functions/tsconfig.json ./
COPY functions/src ./src
COPY packages /workspace/packages
COPY scripts/prepare-game-packages.mjs /workspace/scripts/prepare-game-packages.mjs
RUN npm run build && npm prune --omit=dev

FROM node:24.18.0-bookworm-slim

ENV NODE_ENV=production \
    ENFORCE_APP_CHECK=true \
    PORT=8080
WORKDIR /app
COPY --from=build --chown=node:node /workspace/functions/package.json ./package.json
COPY --from=build --chown=node:node /workspace/functions/node_modules ./node_modules
COPY --from=build --chown=node:node /workspace/functions/lib ./lib
COPY --from=build --chown=node:node /workspace/functions/data ./data
USER node
EXPOSE 8080
CMD ["node", "lib/gameServer.js"]
