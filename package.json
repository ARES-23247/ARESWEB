{
  "name": "ares-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-static-routes.mjs",
    "preview": "vite preview",
    "validate:runtime": "node scripts/verify-runtime.mjs",
    "validate:agents": "node scripts/validate-agent-config.mjs",
    "check:route-security": "node scripts/check-route-security.mjs",
    "validate:security-observability": "node scripts/validate-security-observability.mjs",
    "validate:functions-deploy-lock": "node scripts/verify-functions-npm-lock.mjs",
    "validate:game-deployment": "node scripts/verify-game-cloud-run.mjs --validate-contract",
    "generate:sims": "node --experimental-strip-types scripts/generate-sim-registry.ts",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules": "firebase emulators:exec --project aresweb-ci --only firestore,storage \"node node_modules/vitest/vitest.mjs run --config vitest.rules.config.ts\"",
    "test:functions-emulator": "firebase emulators:exec --project aresweb-ci --only firestore \"pnpm --filter functions test:emulator\"",
    "test:e2e": "playwright test",
    "appcheck:storage-observe": "node scripts/check-storage-app-check-observation.mjs",
    "media:inventory": "node scripts/inventory-media-references.mjs",
    "media:migrate": "node scripts/migrate-media-references.mjs",
    "media:rollback": "node scripts/rollback-media-references.mjs",
    "content:validate": "node scripts/validate-learning-catalog.mjs",
    "content:readability": "node scripts/learning-readability.mjs",
    "content:verify": "node scripts/validate-learning-catalog.mjs --verify-remote",
    "content:audit-source-worktree": "node scripts/learning-source-worktree.mjs",
    "content:refresh-sources": "node scripts/refresh-learning-source-authority.mjs",
    "content:prepare": "node scripts/validate-learning-catalog.mjs --write",
    "content:release-validate": "pnpm run content:prepare && node scripts/validate-learning-release-candidate.mjs",
    "content:approval": "node scripts/migrate-learning-content.mjs --prepare-approval",
    "content:migrate": "node scripts/migrate-learning-content.mjs",
    "test:content-migration": "vitest run --config vitest.learning-migration.config.mts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.3",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.14",
    "firebase": "^12.18.0",
    "framer-motion": "^13.1.1",
    "jszip": "^3.10.1",
    "leva": "^0.10.1",
    "lucide-react": "^1.33.0",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "prettier": "^3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "react-router-dom": "^7.18.2",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "sucrase": "3.35.1",
    "tailwind-merge": "^3.6.0",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "firebase-tools": "15.28.1",
    "jsdom": "^30.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11",
    "workbox-window": "^7.4.1"
  }
}
