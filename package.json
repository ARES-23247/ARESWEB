{
  "name": "ares-portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": ">=11.21.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prerender-static-routes.mjs",
    "preview": "vite preview",
    "validate:runtime": "node scripts/verify-runtime.mjs",
    "validate:agents": "node scripts/validate-agent-config.mjs",
    "generate:sims": "node --experimental-strip-types scripts/generate-sim-registry.ts",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:rules:unit": "vitest run --config vitest.rules.config.ts",
    "test:rules": "firebase emulators:exec --project aresweb-ci --only firestore,storage \"node node_modules/vitest/vitest.mjs run --config vitest.rules.config.ts\"",
    "test:functions-emulator": "firebase emulators:exec --project aresweb-ci --only firestore \"pnpm --filter functions test:emulator\"",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@babel/standalone": "^8.0.4",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.101.4",
    "@xyflow/react": "^12.11.2",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.13",
    "firebase": "^12.17.0",
    "framer-motion": "^13.1.0",
    "jszip": "^3.10.1",
    "leva": "^0.10.1",
    "lucide-react": "^1.28.0",
    "mermaid": "^11.16.1",
    "monaco-editor": "^0.55.1",
    "monaco-vim": "^0.4.4",
    "prettier": "^3.9.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-helmet-async": "^3.0.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.2",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "three": "^0.184.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-security": "^4.0.1",
    "firebase-tools": "15.26.0",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "workbox-window": "^7.4.1"
  }
}
