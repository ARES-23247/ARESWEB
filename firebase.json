{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/!(assets){,/**}",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://apis.google.com https://accounts.google.com https://www.gstatic.com https://www.google.com https://www.recaptcha.net https://www.googletagmanager.com; script-src-attr 'none'; style-src 'self'; style-src-elem 'self' 'unsafe-inline' https://fonts.googleapis.com; style-src-attr 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://api.dicebear.com https://*.googleusercontent.com https://*.google.com https://firebasestorage.googleapis.com https://*.googleapis.com https://*.ytimg.com https://img.youtube.com https://images.unsplash.com https://*.google-analytics.com https://*.analytics.google.com; connect-src 'self' https://accounts.google.com https://www.google.com https://recaptcha.net https://www.recaptcha.net https://*.googleapis.com https://securetoken.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://identitytoolkit.googleapis.com https://*.google-analytics.com https://*.analytics.google.com; frame-src 'self' https://aresfirst-portal.firebaseapp.com https://accounts.google.com https://docs.google.com https://drive.google.com https://www.google.com https://recaptcha.net https://www.youtube.com https://youtube.com https://cad.onshape.com; worker-src 'self' blob:; media-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests;"
          }
        ]
      },
      {
        "source": "/dashboard{,/**}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/tasks",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/tournaments{,/**}",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          }
        ]
      },
      {
        "source": "/api/og",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400, s-maxage=31536000, immutable"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
          }
        ]
      },
      {
        "source": "/feed.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/api/feed.xml",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=3600, stale-while-revalidate=86400"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      },
      {
        "source": "/api/photos/public/media/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300, s-maxage=300, must-revalidate"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          }
        ]
      }
    ],
    "trailingSlash": false,
    "rewrites": [
      {
        "source": "/api/app-check{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/sitemap.xml",
        "function": "publicApi"
      },
      {
        "source": "/api/calendar{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/announcements{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/sponsors{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/outreach{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/tournaments{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/robots{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/store{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/finance{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/reference",
        "function": "publicApi"
      },
      {
        "source": "/api/og{,/**}",
        "function": "publicApi"
      },
      {
        "source": "/api/sitemap.xml",
        "function": "publicApi"
      },
      {
        "source": "/feed.xml",
        "function": "publicApi"
      },
      {
        "source": "/api/feed.xml",
        "function": "publicApi"
      },
      {
        "source": "/api/inquiries{,/**}",
        "function": "coreApi"
      },
      {
        "source": "/api/profiles{,/**}",
        "function": "coreApi"
      },
      {
        "source": "/api/photos{,/**}",
        "function": "mediaApi"
      },
      {
        "source": "/api/ai{,/**}",
        "function": "mediaApi"
      },
      {
        "source": "/api/videos{,/**}",
        "function": "mediaApi"
      },
      {
        "source": "/api/drive{,/**}",
        "function": "driveApi"
      },
      {
        "source": "/api/tasks{,/**}",
        "function": "communicationsApi"
      },
      {
        "source": "/api/webhooks{,/**}",
        "function": "communicationsApi"
      },
      {
        "source": "/api/simulations{,/**}",
        "function": "communicationsApi"
      },
      {
        "source": "/api/zulip{,/**}",
        "function": "communicationsApi"
      },
      {
        "source": "/api/**",
        "function": "publicApi"
      },
      {
        "source": "/__deployment-health/web",
        "function": "web"
      },
      {
        "source": "/academy/playground",
        "destination": "/index.html"
      },
      {
        "source": "/blog/**",
        "function": "web"
      },
      {
        "source": "/academy/**",
        "function": "web"
      },
      {
        "source": "/docs/**",
        "function": "web"
      },
      {
        "source": "/events/**",
        "function": "web"
      },
      {
        "source": "/robots/**",
        "function": "web"
      },
      {
        "source": "/tournaments",
        "destination": "/prerender/tournaments.html"
      },
      {
        "source": "/dashboard{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/tournaments{,/**}",
        "destination": "/index.html"
      },
      {
        "source": "/tasks",
        "destination": "/index.html"
      },
      {
        "source": "/",
        "destination": "/prerender/home.html"
      },
      {
        "source": "/about",
        "destination": "/prerender/about.html"
      },
      {
        "source": "/brand",
        "destination": "/prerender/brand.html"
      },
      {
        "source": "/accessibility",
        "destination": "/prerender/accessibility.html"
      },
      {
        "source": "/academy",
        "destination": "/prerender/academy.html"
      },
      {
        "source": "/blog",
        "destination": "/prerender/blog.html"
      },
      {
        "source": "/calendar",
        "destination": "/prerender/calendar.html"
      },
      {
        "source": "/developer-api",
        "destination": "/prerender/developer-api.html"
      },
      {
        "source": "/docs",
        "destination": "/prerender/docs.html"
      },
      {
        "source": "/finance",
        "destination": "/prerender/finance.html"
      },
      {
        "source": "/gallery",
        "destination": "/prerender/gallery.html"
      },
      {
        "source": "/join",
        "destination": "/prerender/join.html"
      },
      {
        "source": "/leaderboard",
        "destination": "/prerender/leaderboard.html"
      },
      {
        "source": "/location-morgantown",
        "destination": "/prerender/location-morgantown.html"
      },
      {
        "source": "/outreach",
        "destination": "/prerender/outreach.html"
      },
      {
        "source": "/privacy",
        "destination": "/prerender/privacy.html"
      },
      {
        "source": "/robotics-west-virginia",
        "destination": "/prerender/robotics-west-virginia.html"
      },
      {
        "source": "/robots",
        "destination": "/prerender/robots.html"
      },
      {
        "source": "/seasons",
        "destination": "/prerender/seasons.html"
      },
      {
        "source": "/sponsors",
        "destination": "/prerender/sponsors.html"
      },
      {
        "source": "/store",
        "destination": "/prerender/store.html"
      },
      {
        "source": "/tech-stack",
        "destination": "/prerender/tech-stack.html"
      },
      {
        "source": "/terms",
        "destination": "/prerender/terms.html"
      },
      {
        "source": "/videos",
        "destination": "/prerender/videos.html"
      }
    ]
  },
  "functions": {
    "source": "functions",
    "codebase": "default"
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "storage": {
      "port": 9199
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
